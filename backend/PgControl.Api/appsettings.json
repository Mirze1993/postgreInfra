{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Key": "dev-only-key-change-in-prod-min-32-chars!!",
    "Issuer": "pg-control"
  },
  "ConnectionStrings": {
    "Metadata": "Host=localhost;Port=5433;Database=pgcontrol;Username=pgcontrol;Password=pgcontrolpass",
    "HaProxyWrite": "Host=haproxy;Port=5000;Database=postgres;Username=postgres;Password=postgrespass",
    "MigrationStaging": "Host=metadata-db;Port=5432;Database=migration_staging;Username=pgcontrol;Password=pgcontrolpass"
  },
  "Flyway": {
    "StagingConnection": {
      "Url": "jdbc:postgresql://metadata-db:5432/migration_staging",
      "User": "pgcontrol",
      "Password": "pgcontrolpass"
    },
    "ProductionConnection": {
      "Url": "jdbc:postgresql://haproxy:5000/postgres",
      "User": "postgres",
      "Password": "postgrespass"
    }
  },
  "Patroni": {
    "Nodes": [
      "http://pg1:8008",
      "http://pg2:8008",
      "http://pg3:8008",
      "http://pg5:8008",
      "http://pg6:8008"
      
    ]
  },
  "PgBackRest": {
    "ContainerName": "pg1",
    "Stanza": "pgcluster"
  },
  "AllowedHosts": "*"
}