{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Key": "dev-only-key-change-in-prod-min-32-chars!!",
    "Issuer": "pg-control"
  },
  "ConnectionStrings": {
    "Metadata": "Host=localhost;Port=5433;Database=pgcontrol;Username=pgcontrol;Password=pgcontrolpass",
    "HaProxyWrite": "Host=haproxy;Port=5000;Database=postgres;Username=postgres;Password=postgrespass",
    "MigrationStaging": "Host=metadata-db;Port=5432;Database=migration_staging;Username=pgcontrol;Password=pgcontrolpass"
  },
  "Flyway": {
    "StagingPath": "/migrations/staging",
    "ProductionPath": "/migrations/production",
    "StagingConnection": "Host=metadata-db;Port=5432;Database=migration_staging;Username=pgcontrol;Password=pgcontrolpass",
    "ProductionConnection": "Host=haproxy;Port=5000;Database=postgres;Username=postgres;Password=postgrespass"
  },
  "Patroni": {
    "Nodes": [
      "http://pg1:8008",
      "http://pg2:8008"
    ]
  },
  "PgBackRest": {
    "ContainerName": "pg1",
    "Stanza": "pgcluster"
  },
  "AllowedHosts": "*"
}